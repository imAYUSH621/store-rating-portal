{
  "name": "store-rating-portal",
  "version": "1.0.0",
  "description": "Full-stack role-based store rating platform with Express.js, React, and PostgreSQL/SQLite",
  "main": "api/index.js",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "seed": "npm --prefix backend run seed",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "node start-dev.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "sql.js": "^1.12.0"
  },
  "keywords": [
    "express",
    "react",
    "postgresql",
    "sqlite",
    "jwt",
    "rbac",
    "store-rating",
    "vercel"
  ],
  "author": "Ayush Anand",
  "license": "ISC"
}
